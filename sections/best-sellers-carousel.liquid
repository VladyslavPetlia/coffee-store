{% comment %}
  Best Sellers Carousel Section
  Compatible with Shopify Dawn Theme
  Reusable section with Theme Editor controls
{% endcomment %}

{{ 'best-sellers-carousel.css' | asset_url | stylesheet_tag }}

<div class="best-sellers-carousel-section section-{{ section.id }}-padding">
  <div class="page-width">
    {% comment %} Section Header {% endcomment %}
    {% if section.settings.heading != blank %}
      <div class="best-sellers-header">
        {% if section.settings.breadcrumb_text != blank %}
          <div class="breadcrumbs">
            <button type="button" class="breadcrumbs__button">
              <span>{{ section.settings.breadcrumb_text }}</span>
            </button>
          </div>
        {% endif %}

        <h2
          class="best-sellers-heading"
          style="
            color: {{ section.settings.heading_color }};
            font-size: {{ section.settings.heading_size }}px;
          "
        >
          {{ section.settings.heading }}
        </h2>
      </div>
    {% endif %}

    {% comment %} Products Carousel {% endcomment %}
    <div class="best-sellers-carousel__container">
      <div class="swiper best-sellers-swiper">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            {% if block.type == 'product_card' %}
              <div class="swiper-slide" {{ block.shopify_attributes }}>
                <div class="product-card {% if block.settings.is_active %}active{% endif %}">
                  {% comment %} Product Image {% endcomment %}
                  <div class="product-card__image-wrapper">
                    {% if block.settings.product_image != blank %}
                      {{
                        block.settings.product_image
                        | image_url: width: 400
                        | image_tag: loading: 'lazy', width: 400, height: 'auto', alt: block.settings.product_title
                      }}
                    {% else %}
                      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {% endif %}

                    {% comment %} Active Outline {% endcomment %}
                    {% if block.settings.is_active %}
                      <div class="active-outline"></div>
                    {% endif %}

                    {% comment %} Badge {% endcomment %}
                    {% if block.settings.badge_text != blank %}
                      <div class="product-badge badge-{{ block.settings.badge_style }}">
                        {{ block.settings.badge_text }}
                      </div>
                    {% endif %}
                  </div>

                  {% comment %} Product Info {% endcomment %}
                  <div class="product-card__info">
                    {% if block.settings.product_title != blank %}
                      <h3
                        class="product-card__title"
                        style="
                          color: {{ section.settings.title_color }};
                          font-size: {{ section.settings.title_size }}px;
                        "
                      >
                        {{ block.settings.product_title }}
                      </h3>
                    {% endif %}

                    {% if block.settings.product_description != blank %}
                      <p
                        class="product-card__description"
                        style="
                          color: {{ section.settings.description_color }};
                          font-size: {{ section.settings.description_size }}px;
                        "
                      >
                        {{ block.settings.product_description }}
                      </p>
                    {% endif %}

                    {% comment %} Reviews {% endcomment %}
                    {% if block.settings.show_reviews %}
                      <div class="product-card__reviews">
                        <span class="reviews-value">{{ block.settings.review_rating }}</span>
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="18"
                          height="18"
                          viewBox="0 0 19 19"
                          class="review-star"
                        >
                          <defs>
                            <linearGradient id="star-gradient-{{ block.id }}" x1="0%" y1="0%" x2="100%" y2="100%">
                              <stop offset="0%" stop-color="#FFC107"></stop>
                              <stop offset="100%" stop-color="#E9B519"></stop>
                            </linearGradient>
                          </defs>
                          <path fill="url(#star-gradient-{{ block.id }})" d="M6.34 5.85h-.02c-.02 0-.05.01-.12.02-.15.02-.35.02-.7.02h-.06c-1.16 0-2.1 0-2.79.09-.64.08-1.42.27-1.75 1.01-.05.13-.1.26-.12.39-.15.77.36 1.39.83 1.85.5.49 1.27 1.07 2.21 1.78l.04.03c.28.22.45.34.56.45.1.09.11.13.11.13s0 .03.01.04.01.05-.02.19c-.03.16-.1.37-.2.72l-.02.05c-.36 1.16-.65 2.09-.78 2.8-.07.36-.11.71-.07 1.04.04.34.16.69.45.96.1.1.21.18.33.25.35.21.72.22 1.06.15.32-.07.64-.22.95-.4.6-.35 1.36-.93 2.3-1.65l.05-.03c.28-.22.45-.34.58-.42.06-.04.1-.05.11-.06h.07s.05.03.11.06c.13.08.3.21.58.42l.05.03c.94.71 1.7 1.29 2.3 1.65.31.18.63.33.95.4.34.07.71.06 1.06-.15.12-.07.23-.15.33-.25.29-.28.41-.62.45-.96.04-.32 0-.68-.07-1.04-.13-.7-.42-1.64-.78-2.8l-.02-.05c-.11-.35-.17-.56-.2-.72-.03-.14-.02-.18-.02-.19s0-.03.01-.04.01-.04.11-.13c.11-.11.28-.23.56-.45l.04-.03c.94-.71 1.7-1.29 2.21-1.78.47-.46.98-1.08.83-1.85a2.52 2.52 0 0 0-.12-.39c-.32-.74-1.11-.93-1.75-1.01-.69-.09-1.63-.09-2.79-.09h-.06c-.35 0-.55 0-.7-.02-.07 0-.1-.02-.12-.02h-.02s-.02-.01-.03-.02l-.02-.02c-.01-.02-.04-.06-.06-.13-.06-.15-.13-.36-.24-.71l-.02-.05c-.36-1.16-.65-2.09-.94-2.75-.15-.33-.32-.64-.53-.89-.22-.26-.53-.47-.93-.52a1.477 1.477 0 0 0-1.35.52c-.21.25-.38.56-.53.89-.29.65-.58 1.59-.94 2.75l-.02.05c-.11.35-.17.56-.24.71-.03.07-.05.11-.06.13-.01.02-.02.02-.02.02s-.02.01-.03.02z"></path>
                        </svg>
                        <span class="reviews-count">({{ block.settings.review_count }})</span>
                      </div>
                    {% endif %}

                    {% comment %} Link to Product {% endcomment %}
                    {% if block.settings.product_url != blank %}
                      <a
                        href="{{ block.settings.product_url }}"
                        class="product-card__link"
                        aria-label="View {{ block.settings.product_title }}"
                      ></a>
                    {% endif %}
                  </div>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      {% comment %} Navigation Buttons {% endcomment %}
      {% if section.settings.show_navigation %}
        <button class="swiper-btn swiper-button-prev" aria-label="Previous slide">
          <svg xmlns="http://www.w3.org/2000/svg" width="12.5" height="6.31" viewBox="0 0 12.5 6.31">
            <path d="M6.25 6.31c-.18 0-.35-.06-.49-.19L.26 1.31C-.06 1.04-.09.57.19.26S.93-.09 1.24.19l5.01 4.37L11.26.19c.31-.27.79-.24 1.06.07s.24.79-.07 1.06L6.74 6.13c-.14.12-.32.19-.49.19z"></path>
          </svg>
        </button>
        <button class="swiper-btn swiper-button-next" aria-label="Next slide">
          <svg xmlns="http://www.w3.org/2000/svg" width="12.5" height="6.31" viewBox="0 0 12.5 6.31">
            <path d="M6.25 6.31c-.18 0-.35-.06-.49-.19L.26 1.31C-.06 1.04-.09.57.19.26S.93-.09 1.24.19l5.01 4.37L11.26.19c.31-.27.79-.24 1.06.07s.24.79-.07 1.06L6.74 6.13c-.14.12-.32.19-.49.19z"></path>
          </svg>
        </button>
      {% endif %}
    </div>
  </div>
</div>

<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer></script>
<script src="{{ 'best-sellers-carousel.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Best Sellers Carousel",
  "tag": "section",
  "class": "section-best-sellers",
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Best Sellers"
    },
    {
      "type": "text",
      "id": "breadcrumb_text",
      "label": "Breadcrumb Text",
      "default": "Mens / Short Sleeves / Crew Necks",
      "info": "Optional breadcrumb navigation text"
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "Show Navigation Arrows",
      "default": true
    },
    {
      "type": "header",
      "content": "Heading Styling"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#0c0a09"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 32
    },
    {
      "type": "header",
      "content": "Product Card Text Styling"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Product Title Color",
      "default": "#0c0a09"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Product Title Size",
      "default": 18
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#666666"
    },
    {
      "type": "range",
      "id": "description_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Description Size",
      "default": 14
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        {
          "type": "header",
          "content": "Product Information"
        },
        {
          "type": "image_picker",
          "id": "product_image",
          "label": "Product Image"
        },
        {
          "type": "text",
          "id": "product_title",
          "label": "Product Title",
          "default": "Classic Crew"
        },
        {
          "type": "text",
          "id": "product_description",
          "label": "Product Description",
          "default": "Ultra-soft everyday"
        },
        {
          "type": "url",
          "id": "product_url",
          "label": "Product Link"
        },
        {
          "type": "checkbox",
          "id": "is_active",
          "label": "Mark as Active/Selected",
          "default": false,
          "info": "Shows a border outline around this product"
        },
        {
          "type": "header",
          "content": "Badge Settings"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge Text",
          "placeholder": "#1 Best Seller",
          "info": "Leave empty to hide badge"
        },
        {
          "type": "select",
          "id": "badge_style",
          "label": "Badge Style",
          "options": [
            {
              "value": "bestseller",
              "label": "Best Seller (Yellow)"
            },
            {
              "value": "rank",
              "label": "Rank Number (Gray)"
            },
            {
              "value": "custom",
              "label": "Custom"
            }
          ],
          "default": "bestseller"
        },
        {
          "type": "header",
          "content": "Reviews"
        },
        {
          "type": "checkbox",
          "id": "show_reviews",
          "label": "Show Reviews",
          "default": true
        },
        {
          "type": "text",
          "id": "review_rating",
          "label": "Review Rating",
          "default": "4.5",
          "info": "Rating value (e.g., 4.5)"
        },
        {
          "type": "text",
          "id": "review_count",
          "label": "Review Count",
          "default": "66k+",
          "info": "Number of reviews (e.g., 66k+, 1k+)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Best Sellers Carousel",
      "blocks": [
        {
          "type": "product_card",
          "settings": {
            "product_title": "Classic Crew",
            "product_description": "Ultra-soft everyday",
            "badge_text": "#1 Best Seller",
            "badge_style": "bestseller",
            "review_rating": "4.5",
            "review_count": "66k+",
            "is_active": true
          }
        },
        {
          "type": "product_card",
          "settings": {
            "product_title": "Classic Curved",
            "product_description": "Modern curved hem",
            "badge_text": "#2",
            "badge_style": "rank",
            "review_rating": "4.5",
            "review_count": "45k+"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "product_title": "Pocket Crew",
            "product_description": "Classic tee w/pocket",
            "badge_text": "#3",
            "badge_style": "rank",
            "review_rating": "4.6",
            "review_count": "32k+"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "product_title": "Active Crew",
            "product_description": "Performance fabric",
            "badge_text": "#4",
            "badge_style": "rank",
            "review_rating": "4.7",
            "review_count": "12k+"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "product_title": "Active Mesh",
            "product_description": "Performance mesh",
            "badge_text": "#5",
            "badge_style": "rank",
            "review_rating": "4.6",
            "review_count": "258"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "product_title": "Heavyweight Crew",
            "product_description": "Premium heavyweight",
            "badge_text": "#6",
            "badge_style": "rank",
            "review_rating": "4.5",
            "review_count": "1k+"
          }
        }
      ]
    }
  ]
}
{% endschema %}

{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}
